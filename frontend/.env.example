# Leave these unset in production: the app calls "/api" on its own domain and vercel.json proxies it
# to the backend. That keeps the login cookie first-party, which iOS/Safari requires.
# For local development the defaults (http://localhost:3000) already work.
#
# VITE_API_BASE=http://localhost:3000/api
# VITE_BACKEND_URL=http://localhost:3000   # websocket origin, defaults to the API origin
