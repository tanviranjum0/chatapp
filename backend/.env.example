PORT=3000
NODE_ENV=development

# Comma separated list of allowed frontend origins (no trailing slash). Required in production.
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatapp
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="Tanvir's Chatapp Team"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ARCJET_KEY=
ARCJET_ENV=development

# --- optional: AI features (smart replies, better translation, "AI Assistant" bot) ---
# Without a key smart replies use simple heuristics and translation uses a free public service.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# --- optional: TURN relay so calls work behind strict NATs / corporate firewalls ---
# e.g. from Cloudflare Realtime TURN, Metered, Twilio or a self hosted coturn
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
